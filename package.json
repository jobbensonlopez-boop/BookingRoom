{
  "name": "kelmer-room-booking",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
