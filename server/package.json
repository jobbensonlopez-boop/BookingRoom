{
  "name": "@kelmer/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=../.env src/migrate.ts",
    "seed": "tsx --env-file-if-exists=../.env src/seed.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@kelmer/shared": "*",
    "express": "^4.21.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
