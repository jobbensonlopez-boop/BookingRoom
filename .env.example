# All settings are read by the server at runtime (also those the browser needs,
# which it fetches from /api/client-config). On Azure, set these as App Settings.
# Full reference: docs/azure-deployment.md

# ---- Database ----
# Local: postgres://booking:booking@localhost:5432/booking
# Azure: postgres://<user>:<url-encoded password>@<server>.postgres.database.azure.com:5432/booking?sslmode=verify-full
DATABASE_URL=postgres://booking:booking@localhost:5432/booking
# Apply pending migrations at startup (the Docker image sets this to true).
# RUN_MIGRATIONS=true

# ---- App ----
PORT=3001
# Office timezone (IANA name). All times are shown and validated in this zone.
OFFICE_TIMEZONE=Asia/Dubai
ROOM_NAME=Boardroom
# Must match the attendees check in db/migrations (8).
ROOM_CAPACITY=8
# Folder with the built web app to serve (the Docker image sets this).
# STATIC_DIR=../web/dist

# ---- Sign-in ----
# "entra" (default, production) or "dev" (no sign-in; refused when NODE_ENV=production)
AUTH_MODE=entra
# Directory (tenant) ID
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID of the *API* app registration
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID of the *SPA* app registration
ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Optional overrides
# ENTRA_REQUIRED_SCOPE=access_as_user
# ENTRA_API_SCOPE=api://<api-client-id>/access_as_user
# Dev mode identity
# DEV_USER_ID=dev-alex
# DEV_USER_NAME=Alex Morgan
