# ---- API server ----
DATABASE_URL=postgres://booking:booking@localhost:5432/booking
PORT=3001
# Office timezone (IANA name). All times are shown and validated in this zone.
OFFICE_TIMEZONE=Asia/Dubai
ROOM_NAME=Boardroom
# Must match the attendees check in db/migrations (8).
ROOM_CAPACITY=8
# Serve the built frontend from the API (production): web/dist
# STATIC_DIR=../web/dist

# "entra" (default, production) or "dev" (no sign-in; local only)
AUTH_MODE=entra
# Entra ID: Directory (tenant) ID and the Application (client) ID of the *API* app registration
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_REQUIRED_SCOPE=access_as_user
# Dev mode identity
# DEV_USER_ID=dev-alex
# DEV_USER_NAME=Alex Morgan

# ---- Web (Vite; read at build time) ----
VITE_AUTH_MODE=entra
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID of the *SPA* app registration
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
